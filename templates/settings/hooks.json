{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/privacy-block.cjs"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/privacy-block.cjs"
      },
      {
        "command": "node .cursor/hooks/safety-guard.cjs",
        "timeout": 5
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/privacy-block.cjs"
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "node .cursor/hooks/privacy-block.cjs"
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/edit-lint.cjs",
        "matcher": "Write",
        "timeout": 10
      },
      {
        "command": "node .cursor/hooks/grep-negative.cjs",
        "matcher": "Grep",
        "timeout": 5
      }
    ]
  }
}
